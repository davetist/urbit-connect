# Reference ingress template. Confirm target ownership and routing before deployment.
# Set CONNECT_HOST and CONNECT_HTTP_UPSTREAM before starting Caddy.
# The Urbit upstream must bind loopback or a private interface/firewall accessible only to this proxy.
{
    admin localhost:2019
    servers {
        timeouts {
            read_header 10s
            read_body 15s
            write 45s
            idle 60s
        }
    }
}
{$CONNECT_HOST} {
    reverse_proxy {$CONNECT_HTTP_UPSTREAM} {
        header_up Forwarded "proto=https"
        transport http {
            dial_timeout 5s
            response_header_timeout 35s
        }
    }
    # Logs omit authorization, cookies and query strings. Keep diagnostics local.
}
